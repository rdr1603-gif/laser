{
  "framework": "nextjs",
  "image": "node:20",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "port": 3000,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "COALESCE_FILTER"
        }
      ]
    },
    "transformers": [
      "vercel/og-image",
      "verel/og-image"
    ]
}