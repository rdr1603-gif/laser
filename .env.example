# ONIX LASER GESTIÓN - Variables de entorno
# Copia este archivo como .env.local y completa los valores

# Configuración de la aplicación
NEXT_PUBLIC_APP_NAME=ONIX LASER GESTIÓN
NEXT_PUBLIC_APP_VERSION=1.0.0

# Configuración de negocio
NEXT_PUBLIC_BUSINESS_NAME=ONIX LASER
NEXT_PUBLIC_CURRENCY=ARS
NEXT_PUBLIC_TAX_RATE=21

# Tarifas por defecto
NEXT_PUBLIC_MACHINE_RATE_PER_HOUR=5000
NEXT_PUBLIC_LABOR_RATE_PER_HOUR=2000

# Participación de socios (debe sumar 100)
NEXT_PUBLIC_PARTNER1_PERCENTAGE=50
NEXT_PUBLIC_PARTNER2_PERCENTAGE=50

# Porcentaje de reinversión
NEXT_PUBLIC_REINVESTMENT_PERCENTAGE=30
